# spectado-stream-recorder configuration
#
# Copy to .env (`cp .env.example .env`) and adjust. Every variable is listed
# with its default; a commented line means the default is used. Durations use
# Go syntax (10s, 5m, 6h); sizes accept 16MiB / 2GiB / 512MiB style suffixes.
#
# This file is pre-configured for the LOCAL TEST STACK in
# docker-compose.example.yml: uploads are disabled so no R2 account is needed.
# To upload to real Cloudflare R2: set UPLOAD_DISABLED=false (or remove the
# line) and uncomment + fill in the S3_* block below.

# ---------------------------------------------------------------------------
# Schedule
# ---------------------------------------------------------------------------
# REQUIRED. URL of the schedule JSON (array or {"items":[...]}). The example
# stack points at the bundled schedule server.
SCHEDULE_URL=http://schedule:8000/schedule.json
# How often the schedule is re-fetched (ETag / If-None-Match is used).
#SCHEDULE_POLL_INTERVAL=60s
# HTTP timeout for one schedule fetch.
#SCHEDULE_FETCH_TIMEOUT=20s
# Optional raw header sent with schedule requests, e.g. "Authorization: Bearer xyz".
#SCHEDULE_AUTH_HEADER=
# Time zone applied to schedule timestamps that carry no UTC offset (IANA name).
#SCHEDULE_DEFAULT_TZ=UTC

# ---------------------------------------------------------------------------
# Storage / retention
# ---------------------------------------------------------------------------
# Directory for recordings and state (the volume mount inside the container).
#DATA_DIR=/data
# How long successfully uploaded files are kept locally before deletion.
#RETENTION_UPLOADED=24h

# ---------------------------------------------------------------------------
# HTTP API / metrics
# ---------------------------------------------------------------------------
# Listen address of the HTTP server (API, /metrics, /healthz, /readyz).
#HTTP_ADDR=:8080
# Optional bearer token required for /api/* (empty = no auth).
#API_TOKEN=
# Also require the API token for /metrics (true/false).
#METRICS_REQUIRE_AUTH=false

# ---------------------------------------------------------------------------
# S3 / Cloudflare R2 upload
# ---------------------------------------------------------------------------
# true = keep files locally and never upload (test mode). ACTIVE for the
# example stack; set to false (or delete) for real R2 uploads.
UPLOAD_DISABLED=true
# S3-compatible endpoint. For R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Region; R2 uses "auto".
#S3_REGION=auto
# Target bucket name.
#S3_BUCKET=my-recordings
# R2 API token credentials (Access Key ID / Secret Access Key).
#S3_ACCESS_KEY_ID=<ACCESS_KEY_ID>
#S3_SECRET_ACCESS_KEY=<SECRET_ACCESS_KEY>
# Optional key prefix prepended to every object key, e.g. recordings/
#S3_PREFIX=
# Use path-style addressing (required for R2 and most non-AWS endpoints).
#S3_FORCE_PATH_STYLE=true
# Checksum algorithm for uploads: none|crc32|crc32c ("none" is safest for R2).
#S3_CHECKSUM_ALGORITHM=none
# Use conditional PUT (If-None-Match: *) so existing objects are never overwritten.
#S3_CONDITIONAL_PUT=true
# Number of parallel uploads.
#UPLOAD_CONCURRENCY=4
# Multipart part size.
#UPLOAD_PART_SIZE=16MiB
# Maximum backoff between upload retries.
#UPLOAD_BACKOFF_MAX=5m
# Assumed minimum upload speed (bytes/s) for the per-attempt deadline: 10 min + size / throughput.
#UPLOAD_MIN_THROUGHPUT=128KiB

# ---------------------------------------------------------------------------
# Recording behaviour
# ---------------------------------------------------------------------------
# Start recording this long before the scheduled start.
#RECORD_START_EARLY=10s
# Keep recording this long after the scheduled end.
#RECORD_STOP_LATE=30s
# Rotate (split) a recording into a new file after this duration; 0 = no rotation (e.g. 6h).
#MAX_SESSION_DURATION=0
# Maximum simultaneous recordings; 0 = unlimited.
#MAX_RECORDINGS=0
# Refuse to start new recordings when free disk space drops below this.
#MIN_FREE_DISK=2GiB

# ---------------------------------------------------------------------------
# ffmpeg / ffprobe
# ---------------------------------------------------------------------------
# Path to the ffmpeg binary.
#FFMPEG_PATH=ffmpeg
# Path to the ffprobe binary.
#FFPROBE_PATH=ffprobe
# Timeout for probing a stream before recording.
#FFPROBE_TIMEOUT=15s
# Maximum simultaneous ffprobe runs.
#PROBE_CONCURRENCY=32
# Audio codec handling: auto (copy if the source is already AAC, else transcode) | aac | copy.
#AUDIO_CODEC=auto
# AAC bitrate used when transcoding.
#AUDIO_BITRATE=128k
# User-Agent header sent by ffmpeg to stream servers.
#FFMPEG_USER_AGENT=spectado-stream-recorder/1.0
# Network read/write timeout passed to ffmpeg (-rw_timeout).
#FFMPEG_RW_TIMEOUT=10s
# Restart ffmpeg if the output file does not grow for this long.
#FFMPEG_STALL_TIMEOUT=60s
# Minimum backoff before restarting a failed ffmpeg.
#FFMPEG_RESTART_BACKOFF_MIN=1s
# Maximum backoff before restarting a failed ffmpeg.
#FFMPEG_RESTART_BACKOFF_MAX=30s
# Time ffmpeg gets to exit cleanly after SIGINT (sent twice) before it is SIGKILLed.
#FFMPEG_STOP_GRACE=5s
# How ffmpeg stderr is logged: warn|debug|off.
#FFMPEG_STDERR_LOG=warn
# Verify TLS certificates of stream sources (ffmpeg default is off). Per-item override: "insecureTLS": true
#FFMPEG_TLS_VERIFY=false

# ---------------------------------------------------------------------------
# Process / runtime
# ---------------------------------------------------------------------------
# Maximum time for graceful shutdown (stop recordings, finish uploads). Keep
# below the container stop_grace_period (60s in the example compose file).
#SHUTDOWN_TIMEOUT=45s
# Interval for system/cgroup metrics collection.
#SYSMON_INTERVAL=10s
# Log level: debug|info|warn|error.
#LOG_LEVEL=info
# Log format: json|text.
#LOG_FORMAT=json
# Go runtime soft memory limit for the recorder process itself (not ffmpeg).
#GOMEMLIMIT=512MiB
